{
  "name": "pedro-silva-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "preview": "serve out -l tcp://127.0.0.1:3100 --no-clipboard",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test",
    "test:unit": "tsx --test tests/*.test.ts",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "check:export": "node scripts/check-export.mjs",
    "build:production": "node scripts/build-production.mjs",
    "check:production": "node scripts/check-export.mjs --production",
    "prebuild": "node scripts/third-party-notices.mjs",
    "prebuild:production": "node scripts/third-party-notices.mjs",
    "check:licenses": "node scripts/third-party-notices.mjs --check"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "phaser": "3.90.0",
    "motion": "14.14.0",
    "lucide-react": "1.78.0",
    "tailwindcss": "4.3.5",
    "@tailwindcss/postcss": "4.3.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "@playwright/test": "1.65.1",
    "@axe-core/playwright": "4.14.0",
    "tsx": "4.23.15",
    "serve": "14.2.8",
    "lighthouse": "13.6.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
